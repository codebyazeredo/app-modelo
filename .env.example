# URL base da API consumida pelo app (sem barra no final).
# Em produção PRECISA ser https:// — o app recusa subir com http:// fora de
# desenvolvimento local (ver core/config/env.js).
# Ex.: EXPO_PUBLIC_API_URL=https://api.seudominio.com
#
# Atenção: qualquer variável EXPO_PUBLIC_* fica embutida em texto no bundle
# final do app. NUNCA coloque aqui API keys, secrets ou credenciais — apenas
# valores que já seriam públicos (como a URL da API).
EXPO_PUBLIC_API_URL=http://localhost:3000
